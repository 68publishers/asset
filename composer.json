{
	"name": "68publishers/asset",
	"description": "Integration of Symfony's Asset component into Nette Framework.",
	"keywords": ["68publishers", "asset", "nette"],
	"license": "MIT",
	"authors": [
		{
			"name": "Tomáš Glawaty",
			"email": "tomasglawaty@icloud.com"
		}
	],
	"require": {
		"php": "^8.3",
		"latte/latte": "^3.0",
		"nette/di": "^3.1.3",
		"nette/utils": "^3.2.10 || ^4.0.1",
		"symfony/asset": "^5.4 || ^6.0 || ^7.0 || ^8.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.89",
		"nette/application": "^3.1.0",
		"nette/bootstrap": "^3.1",
		"nette/tester": "^2.6",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-nette": "^2.0",
		"roave/security-advisories": "dev-latest"
	},
	"conflict": {
		"nette/schema": "<1.2.0"
	},
	"autoload": {
		"psr-4": {
			"SixtyEightPublishers\\Asset\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SixtyEightPublishers\\Asset\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	}
}
